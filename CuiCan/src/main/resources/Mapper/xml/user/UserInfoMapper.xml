<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.cuican.Mapper.user.UserInfoMapper">

    <resultMap id="UserInfoMap" type="org.example.cuican.Bean.user.UserInfo">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="bio" column="bio"/>
        <result property="signature" column="signature"/>
        <result property="profession" column="profession"/>
        <result property="birthday" column="birthday"/>
        <result property="address" column="address"/>
    </resultMap>

    <select id="selectByUserId" resultMap="UserInfoMap">
        SELECT * FROM user_info WHERE user_id = #{userId}
    </select>

    <!-- 新增或更新扩展信息（user_info.user_id 唯一） -->
    <insert id="upsert" parameterType="org.example.cuican.Bean.user.UserInfo">
        INSERT INTO user_info(user_id, bio, signature, profession, birthday, address, create_time, update_time)
        VALUES (#{userId}, #{bio}, #{signature}, #{profession}, #{birthday}, #{address}, NOW(), NOW())
        ON DUPLICATE KEY UPDATE
            bio = VALUES(bio),
            signature = VALUES(signature),
            profession = VALUES(profession),
            birthday = VALUES(birthday),
            address = VALUES(address),
            update_time = NOW()
    </insert>
</mapper>
