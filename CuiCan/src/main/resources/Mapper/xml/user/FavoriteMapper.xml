<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.cuican.Mapper.user.FavoriteMapper">

    <select id="selectByUserId" resultType="org.example.cuican.Bean.user.Favorite">
        SELECT * FROM favorite
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO favorite(user_id,product_id,create_time)
        VALUES(#{userId},#{productId},#{createTime})
    </insert>

    <delete id="delete">
        DELETE FROM favorite WHERE id = #{id}
    </delete>


    <select id="countByUserIdAndProductId" resultType="int">
        SELECT COUNT(*) FROM favorite
        WHERE user_id = #{userId} AND product_id = #{productId}
    </select>

    <delete id="deleteByProductId">
        DELETE FROM favorite WHERE user_id = #{userId} AND product_id = #{productId}
    </delete>
</mapper>