<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.cuican.Mapper.admin.AdminProductMapper">
    <resultMap id="productMap" type="org.example.cuican.Bean.product.Product">
        <id property="id" column="id"/><result property="name" column="name"/>
        <result property="price" column="price"/><result property="categoryId" column="category_id"/>
        <result property="coverImage" column="cover_image"/><result property="stock" column="stock"/>
        <result property="description" column="description"/><result property="originalPrice" column="original_price"/>
        <result property="status" column="status"/><result property="createTime" column="create_time"/>
    </resultMap>
    <select id="selectAll" resultMap="productMap">SELECT * FROM product ORDER BY id DESC</select>
    <select id="selectAllPage" resultMap="productMap">SELECT * FROM product ORDER BY id DESC LIMIT #{limit} OFFSET #{offset}</select>
    <select id="countAll" resultType="int">SELECT COUNT(*) FROM product</select>
    <select id="selectByCategory" resultMap="productMap">SELECT * FROM product WHERE category_id=#{categoryId} ORDER BY id DESC</select>
    <select id="selectByCategoryPage" resultMap="productMap">SELECT * FROM product WHERE category_id=#{categoryId} ORDER BY id DESC LIMIT #{limit} OFFSET #{offset}</select>
    <select id="countByCategory" resultType="int">SELECT COUNT(*) FROM product WHERE category_id=#{categoryId}</select>
    <select id="searchByName" resultMap="productMap">SELECT * FROM product WHERE name LIKE CONCAT('%',#{keyword},'%') ORDER BY id DESC</select>
    <select id="searchByNamePage" resultMap="productMap">SELECT * FROM product WHERE name LIKE CONCAT('%',#{keyword},'%') ORDER BY id DESC LIMIT #{limit} OFFSET #{offset}</select>
    <select id="countByKeyword" resultType="int">SELECT COUNT(*) FROM product WHERE name LIKE CONCAT('%',#{keyword},'%')</select>
    <select id="selectById" resultMap="productMap">SELECT * FROM product WHERE id=#{id}</select>
    <select id="selectMaxId" resultType="long">SELECT MAX(id) FROM product</select>
    <insert id="insert">INSERT INTO product(id,name,price,category_id,cover_image,stock,description,original_price,status,create_time) VALUES(#{id},#{name},#{price},#{categoryId},#{coverImage},#{stock},#{description},#{originalPrice},1,NOW())</insert>
    <update id="update">UPDATE product SET name=#{name},price=#{price},category_id=#{categoryId},cover_image=#{coverImage},stock=#{stock},description=#{description},original_price=#{originalPrice},status=#{status} WHERE id=#{id}</update>
    <delete id="deleteById">DELETE FROM product WHERE id=#{id}</delete>
    <update id="updateStock">UPDATE product SET stock=#{stock} WHERE id=#{id}</update>
</mapper>
