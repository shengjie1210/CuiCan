<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.cuican.Mapper.admin.SystemSettingMapper">
    <select id="selectByKey" resultType="org.example.cuican.Bean.admin.SystemSetting">SELECT * FROM system_settings WHERE `key` = #{key}</select>
    <select id="selectAll" resultType="org.example.cuican.Bean.admin.SystemSetting">SELECT * FROM system_settings</select>
    <update id="updateValue">UPDATE system_settings SET `value` = #{value} WHERE `key` = #{key}</update>
    <insert id="upsert">REPLACE INTO system_settings(`key`, `value`) VALUES(#{key}, #{value})</insert>
</mapper>
