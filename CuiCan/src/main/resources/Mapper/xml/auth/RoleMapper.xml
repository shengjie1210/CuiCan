<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.cuican.Mapper.auth.RoleMapper">

    <select id="selectById" resultType="org.example.cuican.Bean.auth.Role">
        SELECT
            id,
            role_name AS roleName,
            role_level AS roleLevel,
            description
        FROM role
        WHERE id = #{id}
    </select>


</mapper>